# LOGIC Web Agent environment template
# Copy this file to .env and update values for your environment.

# Required in production
JWT_SECRET_KEY=CHANGE-ME-USE-A-LONG-RANDOM-SECRET

# Optional (enables AI threat insights/chat)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Auth/session settings
JWT_EXPIRE_MINUTES=480

# API/frontend integration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://localhost:4000
DATA_ROOT=./data

# LM Studio (optional local model endpoint)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model

# CRS detection tuning
CRS_SERVICE_URL=http://crs-detector:8080
CRS_AUDIT_LOG=./data/crs_audit/audit.log
CRS_PARANOIA_LEVEL=1
CRS_BATCH_SIZE=500
CRS_FLUSH_WAIT=10
CRS_TIMEOUT=2
CRS_WORKERS=20
CRS_BACKEND=auto
CRS_RULES_DIR=./data/coreruleset/rules

# Grafana bootstrap credentials (docker-compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE-ME-GRAFANA-PASSWORD
